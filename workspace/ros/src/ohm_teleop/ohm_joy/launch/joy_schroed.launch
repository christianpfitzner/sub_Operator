<?xml version="1.0"?>
<launch>	
	<!-- start joy stick driver-->
	<node pkg="joy"	    type="joy_node"        name="joy_node">
		<param name="autorepeat_rate" value="10"/>
                <param name="dev" value="/dev/input/js0"/>
	</node>
		 
 <node pkg="ohm_joy" type="ohm_joy_rough_node" name="rough_joy" output ="screen">
    <param name = "thresh_speed_flippers" type = "double" value = "1.7"/>
    <param name = "thresh_speed_angular" type = "double" value = "1.0" />
    <param name = "thresh_speed_linear" type = "double" value = "1.0"/>
 </node>    
			
		
</launch>
