<?xml version="1.0"?>
<launch>
	<!-- start joy stick driver-->
	<node pkg="joy"	    type="joy_node"        name="joy_node">
	  <param name = "dev" type = "string" value = "/dev/input/js0"/>
        </node>
    <!-- start configuration node   -->
	<node pkg="ohm_joy" type="ohm_joy_config" name="joy_config"/>
</launch>
