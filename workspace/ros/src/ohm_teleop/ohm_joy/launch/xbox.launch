<launch>
	<!-- start joy stick driver-->
	<node pkg="joy"	    type="joy_node"        name="joy_node">
		<param name="autorepeat_rate" value="10"/>
	</node>
	
	<!-- start node with configuration for x box controller -->
	<node pkg="ohm_joy"     type="ohm_joy_node"     name="ohm_joy_node" output="screen">
		<param name="config_file"    value="$(find ohm_joy)/configurations/xbox.ini"/>
		<remap from="vel_cmd" to="vel/teleop"/>	
		<param name="simon_state" type="string" value="/simon/cortex/state"/>	
	</node>
	
	 <!-- mux_cmdvel installation -->
 	<node pkg="topic_tools" type="mux" name="vel_mux" args="sel_cmdvel vel/autonomy vel/teleop">
 		<remap from="/vel_mux" to="cmd/vel"/>
 	</node>
</launch>
