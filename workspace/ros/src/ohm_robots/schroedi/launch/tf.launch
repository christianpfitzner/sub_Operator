<launch>
<arg  name="TFtime"     default="10"      />
   <!-- <node pkg="tf" type="static_transform_publisher" name="link_laser"       args="-0.40 0.0 -0.13 0 0 0         laser                     base_link                $(arg TFtime)"/>
   <node pkg="tf" type="static_transform_publisher" name="tf_base"          args="0 0 -0.21 0 0 0         base_link                 base_footprint           $(arg TFtime)"/>
   <node pkg="tf" type="static_transform_publisher" name="tf_imu"           args="0.075 0 -0.05 0 0 0     base_link                 sensor_imu               $(arg TFtime)"/> -->
  
  <!--  vertauschte Reihenfolge Laser -> IMU -> Base_Link
   <node pkg="tf" type="static_transform_publisher" name="link_laser"       args="-0.35 0 -0.075 0 0 0    laser                     sensor_imu               $(arg TFtime)"/>
   <node pkg="tf" type="static_transform_publisher" name="tf_imu"           args="-0.05 0  0.075 0 0 0    sensor_imu                base_link                $(arg TFtime)"/>
   <node pkg="tf" type="static_transform_publisher" name="tf_base"          args="0 0 -0.21 0 0 0         base_link                 base_footprint           $(arg TFtime)"/>
   -->

   <!-- Erster link_laser mit 3D Tilt SCanner nutzen, zweiten ohne-->
   <node pkg="tf" type="static_transform_publisher" name="link_laser"       args="0.325 0.0 0.022 0 0 0     base_link    motor                                     $(arg TFtime)"/>
   <!--<node pkg="tf" type="static_transform_publisher" name="link_laser"       args="0.325 0.0 0.125 0 0 0     base_link    laser                                     $(arg TFtime)"/>-->

   <node pkg="tf" type="static_transform_publisher" name="tf_base"          args="0 0 0.21 0 0 0         base_footprint base_link                            $(arg TFtime)"/>
   <node pkg="tf" type="static_transform_publisher" name="tf_imu"           args="0.075 0 -0.05 0 0 0     base_link                 sensor_imu               $(arg TFtime)"/>


   <node pkg="tf" type="static_transform_publisher" name="tf_sh_base"       args="0 -0.16 0.18 0 0 0      schwenkplattform                 sensor_head/yaw/base     $(arg TFtime)"/>
   <node pkg="tf" type="static_transform_publisher" name="tf_sh_pitch"      args="0 0 0.065 0 0 0         sensor_head/yaw/rotated   sensor_head/pitch/base   $(arg TFtime)"/>
                                                                                                                                                             
   <node pkg="tf" type="static_transform_publisher" name="tf_driver_cam"    args="0 0.03 0.06 0 0 0       sensor_head/yaw/rotated   sensor_head/driver_cam   $(arg TFtime)"/> 
   <node pkg="tf"  type="static_transform_publisher" name = "tf_realsense" args = "0.0 0.0 0.0 -0.5 0.5 -0.5 0.5 link_rs frame_rs $(arg TFtime)"/>
</launch>

