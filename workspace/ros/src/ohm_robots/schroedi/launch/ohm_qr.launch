		<param name="tf_cam_frame"         		type="string"  value="georg/camera/left"/>
		<param name="tf_map_frame"              type="string"  value="map"/>
		<param name="qr_intersection_frame"     type="string"  value="/qr/candidate"/>
	</node>		

	
 	<node pkg="ohm_qr_detection" type="ohm_qr_detection_node" name="ohm_qr_detection_right_camera_node" output="screen">	
