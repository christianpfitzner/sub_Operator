<?xml version="1.0"?>
<launch>

  <node name="dynamixel_server_sensor_head" pkg="ohm_dynamixel" type="dynamixel_server" output="screen">
    <param name = "hysth_vel_ctrl" type = "int" value = "20"/>
    <param name = "error_ctrl" type = "int" value = "2"/>
    <param name="config_file" type="string" value="$(find schroedi)/config/sensor_head_dynmxl.xml"/>
  </node>

  <node name="sensor_head" pkg="ohm_sensor_head" type="sensor-head" output="screen">
    <param name = "homing_yaw" type = "double" value = "0.517" />
    <param name = "homing_pitch" type = "double" value = "-0.18" />
    <param name="tf_target"              type="string" value="base_link"                     />
     <param name="tf_source"              type="string" value="schwenkplattform"                            />
     <param name="tf_sensor"              type="string" value="sensor_head/pitch/rotated"     />
    <param name="topic_target_direction" type="string" value="goal/sensor_head"               />
    <param name="topic_target_point"     type="string" value="goal/look_at_victim"            />
    <param name="topic_status_pitch"     type="string" value="/tilt/pos/present"/>
    <param name="topic_status_yaw"       type="string" value="/pan/pos/present"/>
  <!--  <param name="tf_target"              type="string" value="base_footprint"                     />
  
    <param name="tf_source"              type="string" value="map"                            />
    <param name="tf_yaw_source"          type="string" value="sensor_head/yaw/base"     />
    <param name="tf_yaw_target"          type="string" value="sensor_head/yaw/rotated"  />
    <param name="tf_pitch_source"        type="string" value="sensor_head/pitch/base"   />
    <param name="tf_pitch_target"        type="string" value="sensor_head/pitch/rotated"/>
    <param name="tf_sensor"              type="string" value="sensor_head/yaw/base"     />
    <param name="service_mode"           type="string" value="sensor_head/mode"               /> -->
  </node>

  <!--node pkg="tf" type="static_transform_publisher" name="link_sensor_head_base_yaw"
	args="0.04 0 0.17 0 0 0 georg/base georg/sensor_head/yaw/base 50" />
  <node pkg="tf" type="static_transform_publisher" name="link_sensor_head_yaw_pitch"
	args="0 0 0.06 0 0 0 georg/sensor_head/yaw/rotated georg/sensor_head/pitch/base 50" />
  <node pkg="tf" type="static_transform_publisher" name="link_sensor_head_pitch_xtion"
	args="0 0 0.04 0 0.14 0 georg/sensor_head/pitch/rotated georg/sensor_head/xtion 50"/-->
	

	<!-- see cfg/mono.cfg for detail -->  
	<arg name="camera_id"		default="0" />
	<arg name="auto_exposure"	default="false" />
	<arg name="auto_gain"		default="true" />
	<arg name="color"		default="0" /> <!-- 0:MONO8, 1:MONO16, 2:YUV, 3:YCbCr, 4:BGR5, 5:BGR565, 6:BGR8, 7:BGRA8, 9:BGRY8, 9:RGB8, 10:RGBA8, 11, RGBY8 -->
	<arg name="config_path"		default="" />
	<arg name="exposure_time"	default="2.0" />
	<arg name="force_streaming"	default="false" />
	<arg name="frame_id"		default="/camera" />
	<arg name="frame_rate"		default="18.0" />
	<arg name="gain"		default="100" />
	<arg name="gain_boost"		default="true" />
	<arg name="hardware_gamma"	default="true" />
	<arg name="pixel_clock"		default="35" />
	<arg name="trigger"		default="0" /> <!-- 0:AUTO, 1:HARDWARE_RISING, 2:HARDWARE_FALLING -->
	<arg name="zoom"		default="1" />

  <!-- driver cam  -->
<node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen" >
    <param name="video_device" value="/dev/cam-driver" />
    <param name="image_width" value="1280" />
    <param name="image_height" value="720" />
    <param name="pixel_format" value="mjpeg" />
    <param name="camera_frame_id" value="usb_cam" />
    <param name="io_method" value="mmap"/>
  </node>

  <!-- thermal imager -->
  <node pkg = "ohm_seek_thermal" type = "seek_thermal_node" name = "seek_thermal_node" output="screen">
	<param name = "topic_thermal_image" type = "string" value = "thermal_image"/>
	<param name = "freq" type = "double" value = "20.0"/>	
	<param name = "path_calib_file" type = "string" value = ""/>	
	<param name = "tf_frame" type = "string" value = "thermal_imager"/>	
	<param name = "use_pro"  type = "bool"   value = "false" />    <!-- set to false to use standard model -->	
	<param name = "flip_img_180" type = "bool" value = "false"/>
        <param name = "rotate_180" type = "bool" value = "true" />
  </node>
	
  <node name="optris_colorconvert_node" pkg="optris_drivers" type="optris_colorconvert_node" output="screen">
    <param name="palette"            type="int"    value="6"/>                              <!-- see ImageBuilder.h for valid values -->
    <param name="paletteScaling"     type="int"    value="2"/>                              <!-- scaling method for color conversion, see ImageBuilder.h -->
    <param name="temperatureMin"     type="double" value="20"/>                             <!-- set minimum temperature for fixed scaling -->
    <param name="temperatureMax"     type="double" value="40"/>                             <!-- set maximum temperature for fixed scaling -->
    <param name="looprate"           type="double" value="30"/>                             <!-- set frame rate to publish images -->    
    <remap from = "/image_raw" to = "/thermal_image_raw"/>
  <!-- <param name="camera_name"        type="string" value="optris_$(arg serial_nr)"/>   -->  
  <!-- <param name="camera_info_url"    type="string" value="file://$(optenv ROS_HOME /tmp/.ros)/camera_info/optris_$(arg serial_nr).yaml"/> --> <!-- set camera_info_url containing camera calibration -->
  <!-- Uncomment the following line, if you want to use PNG compression. Use rosrun dynamic_reconfigure reconfigure_gui to pick PNG format -->
  <!-- <param name="image_transport" type="string" value="compressed"/> -->
  </node>

</launch>
