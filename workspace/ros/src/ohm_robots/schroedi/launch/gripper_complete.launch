<?xml version="1.0"?>
<launch>

<!--  <include file = "$(find realsense2_camera)/launch/rs_camera.launch"/> --> 
 <node name="usb_cam_gripper" pkg="usb_cam" type="usb_cam_node">
    <param name="video_device" value="/dev/video0" />
    <param name="image_width" value="1280" />
    <param name="image_height" value="720" />
    <param name="pixel_format" value="mjpeg" />
    <param name="camera_frame_id" value="usb_cam" />
    <param name="io_method" value="mmap"/>
    <remap from = "/usb_cam_gripper/image_raw" to = "/gripper/color/image_raw"/>
  </node>
<!-- <node pkg = "uvc_camera" type = "uvc_camera_node" name = "uvc_camera_gripper">
 <param name = "fps" value ="24"/>
 <param name = "width" value = "800"/>
 <param name = "height" value = "600"/>
 <remap from = "image_raw" to = "gripper/color/image_raw"/>
</node> -->
<!-- <include file = "$(find img_rotate)/launch/img_rotate.launch"/> -->
<include file = "$(find ohm_gripper)/launch/gripper_schr.launch"/>
<include file = "$(find schroedi)/launch/sensor_arm_audio.launch"/>
<node pkg ="ohm_gripper" type="action_gripper" name="gripper_grip" output = "screen">
  <param name = "open_position" type = "double" value = "0.0"/>
  <param name = "close_position" type = "double" value = "0.366"/>
</node>

<node pkg="ohm_sensors_gripper" type="serial_node" name="gripper_serial_node" >
  <param name="aim_led" type = "bool" value="true" />
  <param name="enable_leds_manually" type = "bool" value="true" />
  <param name="brightness" type = "double" value="50" />
  <param name="enable_tof" type = "bool" value="true" />
</node>

<node pkg="co2sensor" type="co2sensor_node" name="co2sensor_node"/>
</launch>
