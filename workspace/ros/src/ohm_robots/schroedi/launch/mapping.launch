<?xml version="1.0"?>
<launch>
    <!-- extern parameters -->
    <arg name="map_topic" default="map" />             <!-- topic of occupancy grid -->
    <arg name="get_map_topic" default="map" />         <!-- topic of occupancy grid -->
    <arg name="map_global_offset_x" default="0.0" />   <!-- parameter to move the center of the occupancy grid map -->
    <arg name="map_global_offset_y" default="0.0" />   <!-- parameter to move the center of the occupancy grid map -->
    <arg name ="interval_map_publish" default="0.5"/>
    <!-- <arg name="yaw_offset" default="0.0" /> -->
    <arg name="map_size" default="12" />               <!-- TODO: add an explanation for this parameter -->
    <arg name="cellsize" default="0.025" />
    <arg name="tf_base_frame" default="map" />
    <arg name="config_slam" default="$(find schroedi)/config/config_slam.xml"/>
        
    <!-- ******************* -->
    <node name="slam_node" pkg="ohm_tsd_slam" type="slam_node" output="screen">
	    <rosparam command="load" file="$(find schroedi)/config/slamparams.yaml" /> 
        <!-- topic/node parameters -->
        <param name="map_topic" type="string" value="$(arg map_topic)" />    <!-- topic of occupancy grid -->
        <param name="get_map_topic" type="string" value="$(arg get_map_topic)" />
        <!-- map parameters -->
        <param name="x_offset" type="double" value="$(arg map_global_offset_x)" />    <!-- offset of robot in map in meters -->
        <param name="y_offset" type="double" value="$(arg map_global_offset_y)" />    <!-- offset of robot in map in meters -->
        <param name="map_size" type="int" value="$(arg map_size)" />    <!-- map size -->
        <param name="cellsize" type="double" value="$(arg cellsize)" />    <!-- cell size in meters -->
        <param name="occ_grid_time_interval" type="double" value="2.0" />    <!-- frequency to publish map -->
        <param name="file_config_xml_slam" type="string" value="$(find schroedi)/config/config_slam.xml"/>
        <param name="registration/config_file" type="string" value = "$(find schroedi)/config/config_registration.xml"/>
        <param name="tsd_pdf/config_file" type = "string" value = "$(find schroedi)/config/config_tsdf_pdf_matcher.xml"/>
        <param name="tf_base_frame" type="string" value="$(arg tf_base_frame)" />
        <param name="tf_child_frame" type="string" value="$(arg tf_child_frame)" />
        <param name="tf_odom_frame" type="string" value="$(arg tf_odom_frame)" />
        <param name="tf_footprint_frame" type="string" value="$(arg tf_footprint_frame)" />

        <!-- robot parameters -->
        <param name="max_velocity_rot" type="double" value="$(arg max_velocity_rot)" />    <!-- maximal rotational speed on base_footprint in rad/sec -->
	<param name="max_velocity_lin" type="double" value="$(arg max_velocity_lin)" />    <!-- maximal linear speed in m/s -->
	<param name="local_offset_x" type = "double" value="0.4"/>
<!-- robot parameters use namespaces for multi slam -->   <!-- TODO: pass namespace to slam config xml -->
        
        <param name="topic_pose" type="string" value="pose" />    <!-- topic for robot's pose -->
        <param name="topic_laser" type="string" value="/scan" />    <!-- topic to receive laser scan -->
        
        <param name="tf_child_frame" type="string" value="base_footprint" />
        <param name="tf_odom_frame"  type="string" value="odom" />
        <param name="thresh_min_pose_change_lin" type = "double" value = "0.05"/>
        <param name="thresh_min_pose_change_lin" type = "double" value = "0.03"/>
        <param name="/tsd_pdf/config_file" type = "string" value = "$(find schroedi)/config/config_tsdf_pdf_matcher.xml"/> 
        <param name="/file_config_robot" type = "string" value = "$(find schroedi)/config/config_robot_default.xml"/>
    </node>

	 <node name="map_compression" pkg="ohm_map_compression" type="map-compression">
      <param name="topic_map_compressed" type="string" value="/map_compression/map"/>
      <param name="topic_map" type="string" value="map"/>
      <param name="map/compressed/format" type = "string" value="png"/>
     </node>

       <node name = "report_node" pkg = "ohm_report" type = "report_node" output = "screen">
		<param name = "robot_nbr" type = "int" value = "1"/>
		<param name = "robot0/namespace" type = "string" value = "/schroedi"/>
		<param name = "compressed_map_topic" type = "string" value = "/map"/>
		<param name = "ppi" type = "int" value = "2" />
		<param name = "mission" type = "string" value = "finale_autonomy_auto0"/>
		<param name = "t_geotiff_s" type = "double" value = "30.0"/>
		<param name = "t_sys_ms" type = "int" value = "10"/>
	    <param name = "n_max_maps" type = "int" value = "100"/>
	    <param name = "base_path" type = "string" value = "/home/user"/>
	    <param name = "valid_victim_topic" type = "string" value = "/victim/valid"/> 	
	    <param name = "valid_qr_topic" type = "string" value = "/qr/valid" /> 	 	 	
	</node> 	

  <include file = "$(find sick_tim)/launch/sick_tim551_2050001.launch"/>
  
   <node pkg = "hector_trajectory_server" type = "hector_trajectory_server" name = "trajectory_server" output = "screen">
	  <param name = "source_frame_name" type = "string" value = "base_footprint"/>
	  <remap from = "trajectory" to = "schroedi/trajectory"/>
  </node> 

</launch>
