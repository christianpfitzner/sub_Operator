<?xml version="1.0"?>
<launch>
   <!-- start joy stick driver-->
	<node pkg="joy"	    type="joy_node"        name="joy_node">
		<param name="autorepeat_rate" value="20.0"/>
        <param name="dev" value="/dev/input/js0"/>
	</node>
    
<!--   <include file="$(find operator)/launch/audio_operator.launch"/>  -->  
    <!-- Launch RSM interface including RViz-->
   <include file="$(find rsm_additions)/launch/commander.launch" />
</launch>
