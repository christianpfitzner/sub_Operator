<launch>
 <!-- joy node alt-->
 <!-- <node pkg="joy"         type="joy_node"         name="joy" respawn="true" /> -->

 <!-- joy node -->
  <node respawn="true" pkg="joy"
        type="joy_node" name="joy" >
    <param name="dev" type="string" value="/dev/input/js1" />
    <param name="deadzone" value="0.18" />
     <param name="autorepeat_rate" value="100.0"/>
  </node>

<!--  Einfügen des TF Baums -->
   <include file="$(find schroedi)/launch/tf.launch"   />

  <node pkg="ohm_move"    type="ohm_move_node"    name="ohm_move_node"     />
  <node pkg="ohm_inverse" type="ohm_inverse_node" name="ohm_inverse_node"  />
  
<!--  <include file="$(find ohm_robotarm)/launch/visualization.launch"         /> -->


<arg name="debug" default="false" />
    <arg unless="$(arg debug)" name="launch_prefix" value="" />
    <arg     if="$(arg debug)" name="launch_prefix" value="gdb --ex run --args" />

    <arg name="config" default="true" />
    <arg unless="$(arg config)" name="command_args" value="" />
    <arg     if="$(arg config)" name="command_args" value="-d $(find ohm_robotarm)/launch/manual.rviz" /> 
 
    <node name="$(anon rviz)" pkg="rviz" type="rviz" respawn="false"
     args="$(arg command_args)" output="screen">
    </node>
    
  <include file="$(find ohm_robotarm)/launch/hardware_interface.launch"    /> 


</launch>
