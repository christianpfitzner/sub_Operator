<launch>
<include file="$(find astra_camera)/launch/stereo_s.launch"/>
<node pkg="ohm_visca_control" type="ohm_visca_control_node" name="ohm_visca_control" output="screen">
</node>
  <node name="tamron" pkg="usb_cam" type="usb_cam_node" output="screen" >
    <param name="video_device" value="/dev/tamron-zoom-camera" />
    <param name="image_width" value="1280" />
    <param name="image_height" value="720" />
    <param name="framerate" value="25" />
    <param name="pixel_format" value="yuyv" />
    <param name="camera_frame_id" value="zoom_cam" />
   <param name="io_method" value="mmap"/>
  </node>


<node pkg="ohm_visca_control" type="ohm_tele_proc" name="tele_proc" output="screen"></node>

</launch>
